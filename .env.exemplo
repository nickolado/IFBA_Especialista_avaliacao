# Copie para .env somente se ele ainda não existir.
# Escolha: openai, google, claude ou outro.
PROVEDOR_IA=openai
# Vazio usa o modelo padrão do provedor; ou informe o identificador desejado.
MODELO_IA=
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
# Para PROVEDOR_IA=outro: API compatível com Chat Completions e ferramentas.
# Ollama no host, acessado pelo Docker Desktop: http://host.docker.internal:11434/v1
# Exemplo local: MODELO_IA=qwen3:8b e CHAVE_API_IA=ollama (valor fictício aceito pelo servidor local).
URL_IA=
CHAVE_API_IA=
SENHA_BANCO=admin
# Modelo de embeddings disponível no mesmo endpoint do provedor. Vazio desativa o cache.
MODELO_EMBEDDING=
CACHE_LIMIAR=0.85
CACHE_TTL=86400
# Provedor vazio herda o endpoint/chave do chat. Modelo vazio também herda MODELO_IA.
# Com provedor explícito, configure o modelo desejado; vazio usa o padrão desse provedor.
PROVEDOR_JUIZ=
MODELO_JUIZ=
# URL apenas para PROVEDOR_JUIZ=outro. Chave específica opcional para provedores conhecidos.
# Para um juiz local: PROVEDOR_JUIZ=outro, MODELO_JUIZ=qwen3:8b,
# URL_JUIZ=http://host.docker.internal:11434/v1 e CHAVE_API_JUIZ=ollama.
URL_JUIZ=
CHAVE_API_JUIZ=
